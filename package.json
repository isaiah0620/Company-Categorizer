{
  "name": "company-categorizer-ts",
  "version": "1.0.0",
  "description": "TypeScript port of the n8n 'Companies - Uncategorized' categorization workflow (Google Sheets + Firecrawl + Claude + Postgres).",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "run-once": "node dist/index.js --once",
    "dev": "tsx src/index.ts",
    "dev:once": "tsx src/index.ts --once",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0",
    "tunnel-ssh": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
